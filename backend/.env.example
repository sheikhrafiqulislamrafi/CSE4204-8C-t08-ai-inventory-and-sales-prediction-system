# myShop Backend Configuration
# Copy this file to .env and fill in your values

# Server
PORT=8000

# PostgreSQL Database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=myshop

# JWT Authentication
JWT_SECRET=myshop-ai-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Google AI Studio (Gemma)
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here

# Custom Gemma API (optional)
GEMMA_API_URL=
GEMMA_API_KEY=

# HuggingFace (optional fallback)
HUGGINGFACE_API_KEY=

# Email Service (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=